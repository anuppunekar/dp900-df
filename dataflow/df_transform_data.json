{
	"name": "df_transform_data",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SalesLT_ProductModel",
						"type": "DatasetReference"
					},
					"name": "ProductModel"
				},
				{
					"dataset": {
						"referenceName": "SalesLT_ProductCategory",
						"type": "DatasetReference"
					},
					"name": "ProductCategory"
				},
				{
					"dataset": {
						"referenceName": "SalesLT_Product",
						"type": "DatasetReference"
					},
					"name": "Product"
				},
				{
					"dataset": {
						"referenceName": "SalesLT_ProductSubCategory",
						"type": "DatasetReference"
					},
					"name": "ProductSubCategory"
				},
				{
					"dataset": {
						"referenceName": "csvSalesLT_Product",
						"type": "DatasetReference"
					},
					"name": "csvProduct"
				},
				{
					"dataset": {
						"referenceName": "csvSalesLT_ProductModel",
						"type": "DatasetReference"
					},
					"name": "csvProductModel"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "csvSalesLT_ProductInfo",
						"type": "DatasetReference"
					},
					"name": "csvProductsInfo",
					"rejectedDataLinkedService": {
						"referenceName": "csvSalesLT_ProductErrorInfo",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "csvProductModelcsvProduct"
				},
				{
					"name": "SelectAndRenameColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductModelID as string,",
				"          Name as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ProductModel",
				"source(output(",
				"          ProductCategoryID as string,",
				"          ParentProductCategoryID as string,",
				"          Name as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ProductCategory",
				"source(output(",
				"          ProductID as string,",
				"          Name as string,",
				"          ProductNumber as string,",
				"          Color as string,",
				"          StandardCost as string,",
				"          ListPrice as string,",
				"          Size as string,",
				"          Weight as string,",
				"          ProductCategoryID as string,",
				"          ProductModelID as string,",
				"          SellStartDate as string,",
				"          SellEndDate as string,",
				"          DiscontinuedDate as string,",
				"          ThumbNailPhoto as string,",
				"          ThumbnailPhotoFileName as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Product",
				"source(output(",
				"          ProductCategoryID as string,",
				"          ParentProductCategoryID as string,",
				"          Name as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ProductSubCategory",
				"source(output(",
				"          ProductID as string,",
				"          Name as string,",
				"          ProductNumber as string,",
				"          Color as string,",
				"          StandardCost as string,",
				"          ListPrice as string,",
				"          Size as string,",
				"          Weight as string,",
				"          ProductCategoryID as string,",
				"          ProductModelID as string,",
				"          SellStartDate as string,",
				"          SellEndDate as string,",
				"          DiscontinuedDate as string,",
				"          ThumbNailPhoto as string,",
				"          ThumbnailPhotoFileName as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csvProduct",
				"source(output(",
				"          ProductModelID as string,",
				"          Name as string,",
				"          rowguid as string,",
				"          ModifiedDate as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csvProductModel",
				"csvProductModel, csvProduct join(csvProductModel@ProductModelID == csvProduct@ProductModelID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> csvProductModelcsvProduct",
				"csvProductModelcsvProduct select(mapColumn(",
				"          ProductID,",
				"          Name = csvProduct@Name,",
				"          ProductNumber,",
				"          Color,",
				"          StandardCost,",
				"          ListPrice,",
				"          Size,",
				"          Weight,",
				"          ProductModelID = csvProduct@ProductModelID,",
				"          ProductModelName = csvProductModel@Name",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectAndRenameColumns",
				"SelectAndRenameColumns sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ProductID as string,",
				"          Name as string,",
				"          ProductNumber as string,",
				"          Color as string,",
				"          StandardCost as string,",
				"          ListPrice as string,",
				"          Size as string,",
				"          Weight as string,",
				"          ProductModelID as string,",
				"          ProductModelName as string",
				"     ),",
				"     partitionFileNames:['SalesLT_ProductInfo.csv'],",
				"     truncate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     partitionBy('hash', 1)) ~> csvProductsInfo"
			]
		}
	}
}